# =============================================================
# Bringup Platform - Environment Configuration
# =============================================================
# Copy this file to .env and adjust values as needed.
# Docker Compose reads .env automatically from the project dir.
# The install.sh script generates this file for you.
# =============================================================

# ── Domain ────────────────────────────────────────────────────
DOMAIN=bringup.localhost

# ── Certificate paths (host-side, relative to compose file) ──
CERT_DIR=./certs

# ── Postgres (shared across all service databases) ───────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── MinIO (S3-compatible object store) ───────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=bagmaster-storage

# ── Keycloak / Auth ──────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=password
KC_CLIENT_SECRET=next-auth-secret-change-in-production

# ── Jenkins / Pipeline Engine ────────────────────────────────
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin12345
JENKINS_WEBHOOK_TOKEN=randomtoken
